# Copy to `.env` and fill in values. Restart `npm start` after changes.
#
# Live (Amplify): set REACT_APP_BACKEND_URL to your API Gateway URL, e.g.
# REACT_APP_BACKEND_URL=https://xxxx.execute-api.ap-south-1.amazonaws.com/api
#
# Never put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here — they are bundled
# into the browser. Large uploads use presigned S3 URLs from the backend.

REACT_APP_BACKEND_URL=http://localhost:5001/api

REACT_APP_BASE_URL=https://staging.extramileplay.com
REACT_APP_CLIENT_SECRET=your-client-secret
REACT_APP_LOGIN_API=https://api-staging.extramileplay.com/game-server/login
REACT_APP_GUEST_USER_API=https://api-staging.extramileplay.com/game-server/guest/login
REACT_APP_ORG_API=https://api-staging.extramileplay.com/organization
REACT_APP_REPORTS_BASE_URL=https://api-staging.extramileplay.com
REACT_APP_EM_LOGO=https://staging-games.extramileplay.com/imp/logo/extramileplay-new.png
REACT_APP_ADMIN_REDIRECT=https://staging.extramileplay.com/admin

REACT_APP_S3_PATH=https://2023-extramileplay-php.s3.amazonaws.com/UAT/yoga_quest/
REACT_APP_S3BUCKET_URL=https://staging-extramileplay-public.s3.amazonaws.com
REACT_APP_S3_SOURCE=https://staging-extramileplay-public.s3.amazonaws.com/
REACT_APP_S3_ENVIRMOENT=UAT
REACT_APP_S3_GAME_FOLDER=yoga_quest
REACT_APP_S3_GAME_UPLOAD_BASE=
